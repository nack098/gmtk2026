#pragma kernel K_DownsampleMip0
#pragma kernel K_DownsampleMips
#pragma kernel ResetIndexBatch
#pragma kernel CullingBatch

struct ScrapInstanceData
{
    float id;          
    float3 rotation;   // Pitch (X), Yaw (Y), Roll (Z) in degrees
    float2 scale;      
    float3 position;   
    float3 normal;     
    float pad;         
};

// --- Hi-Z Downsampling Resources ---
Texture2D<float> _InputSource;
Texture2D<float> _InputMip;        // Separate Read Handle for Sub-Mips
RWTexture2D<float> _OutputMip;     // Separate Write Handle for Sub-Mips
int2 _OutputSize;

// --- Culling & Indirect Resources ---
StructuredBuffer<ScrapInstanceData> _AllInstancesBuffer;
RWStructuredBuffer<ScrapInstanceData> _CulledInstancesBuffer;
RWStructuredBuffer<uint> _GlobalArgsBuffer;

matrix _VPMatrix;
float4 _FrustumPlanes[6];
float3 _CameraPosition;
float _MaxDrawDistance;
float _BoundingRadius;
int _TotalInstances;
int _MaxInstancesPerType;
int _ScrapTypeCount;
float _ScreenWidth;  
float _ScreenHeight; 

Texture2D<float> _HiZBuffer;
SamplerState sampler_PointClamp;

// --- Hi-Z Downsampling Kernels (Reversed-Z Conservative) ---

[numthreads(8, 8, 1)]
void K_DownsampleMip0(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_OutputSize.x || id.y >= (uint)_OutputSize.y) return;

    int2 baseCoords = id.xy * 2;
    float d0 = _InputSource[baseCoords + int2(0, 0)];
    float d1 = _InputSource[baseCoords + int2(1, 0)];
    float d2 = _InputSource[baseCoords + int2(0, 1)];
    float d3 = _InputSource[baseCoords + int2(1, 1)];

    // Conservative Reversed-Z: MIN depth guarantees no premature false-culling!
    float conservativeDepth = min(min(d0, d1), min(d2, d3));
    _OutputMip[id.xy] = conservativeDepth;
}

[numthreads(8, 8, 1)]
void K_DownsampleMips(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_OutputSize.x || id.y >= (uint)_OutputSize.y) return;

    int2 baseCoords = id.xy * 2;
    float d0 = _InputMip[baseCoords + int2(0, 0)];
    float d1 = _InputMip[baseCoords + int2(1, 0)];
    float d2 = _InputMip[baseCoords + int2(0, 1)];
    float d3 = _InputMip[baseCoords + int2(1, 1)];

    // Conservative Reversed-Z: MIN depth across mips!
    float conservativeDepth = min(min(d0, d1), min(d2, d3));
    _OutputMip[id.xy] = conservativeDepth;
}

// --- Culling Kernels ---

[numthreads(64, 1, 1)]
void ResetIndexBatch(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_ScrapTypeCount) return;
    _GlobalArgsBuffer[id.x * 5 + 1] = 0; 
}

[numthreads(64, 1, 1)]
void CullingBatch(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_TotalInstances) return;

    ScrapInstanceData instance = _AllInstancesBuffer[id.x];
    uint typeIndex = (uint)instance.id;
    if (typeIndex >= (uint)_ScrapTypeCount) return;

    float3 pos = instance.position;
    float maxRadius = _BoundingRadius * max(instance.scale.x, instance.scale.y);

    // 1. Distance Culling
    float distSq = dot(pos - _CameraPosition, pos - _CameraPosition);
    if (distSq > (_MaxDrawDistance * _MaxDrawDistance)) return;

    // 2. Frustum Culling
    [unroll]
    for (int i = 0; i < 6; i++)
    {
        float distanceToPlane = dot(_FrustumPlanes[i].xyz, pos) + _FrustumPlanes[i].w;
        if (distanceToPlane < -maxRadius) return;
    }

    // 3. Conservative Hi-Z Occlusion Culling
    float4 clipPos = mul(_VPMatrix, float4(pos, 1.0));
    
    if (clipPos.w > 0.0)
    {
        // Compute Clip-Space Extents
        float4 clipMin = mul(_VPMatrix, float4(pos - float3(maxRadius, maxRadius, maxRadius), 1.0));
        float4 clipMax = mul(_VPMatrix, float4(pos + float3(maxRadius, maxRadius, maxRadius), 1.0));

        float3 ndcMin = clipMin.xyz / max(clipMin.w, 0.0001);
        float3 ndcMax = clipMax.xyz / max(clipMax.w, 0.0001);

        float2 uvMin = clamp(min(ndcMin.xy, ndcMax.xy) * 0.5 + 0.5, 0.0, 1.0);
        float2 uvMax = clamp(max(ndcMin.xy, ndcMax.xy) * 0.5 + 0.5, 0.0, 1.0);

        // In Reversed-Z, MIN depth is furthest away from camera
        float instanceFurthestDepth = min(ndcMin.z, ndcMax.z);

        // Screen footprint size in pixels
        float2 pixelSize = (uvMax - uvMin) * float2(_ScreenWidth, _ScreenHeight);
        float maxPixelSize = max(pixelSize.x, pixelSize.y);

        // Mip level calculation with safety clamp against negative/NaN
        float mipLevel = clamp(floor(log2(max(maxPixelSize, 1.0))), 0.0, 7.0);

        // Sample 4 corners of bounding box
        float4 samples;
        samples.x = _HiZBuffer.SampleLevel(sampler_PointClamp, uvMin, mipLevel);
        samples.y = _HiZBuffer.SampleLevel(sampler_PointClamp, float2(uvMax.x, uvMin.y), mipLevel);
        samples.z = _HiZBuffer.SampleLevel(sampler_PointClamp, float2(uvMin.x, uvMax.y), mipLevel);
        samples.w = _HiZBuffer.SampleLevel(sampler_PointClamp, uvMax, mipLevel);

        // Maximum sampled Hi-Z depth represents the nearest surface in Reversed-Z
        float nearestHiZDepth = max(max(samples.x, samples.y), max(samples.z, samples.w));

        // Occlusion Test (Reversed-Z: If instance depth is lower than closest occluder depth, it is occluded!)
        if (instanceFurthestDepth < nearestHiZDepth)
        {
            return; // Occluded!
        }
    }

    // 4. Append Instance
    uint writeOffset;
    InterlockedAdd(_GlobalArgsBuffer[typeIndex * 5 + 1], 1, writeOffset);

    if (writeOffset < (uint)_MaxInstancesPerType)
    {
        uint targetIndex = (typeIndex * _MaxInstancesPerType) + writeOffset;
        _CulledInstancesBuffer[targetIndex] = instance;
    }
}