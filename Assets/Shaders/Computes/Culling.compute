#pragma kernel K_DownsampleMip0
#pragma kernel K_DownsampleMips
#pragma kernel ResetIndexBatch
#pragma kernel CullingBatch

struct ScrapInstanceData
{
    float id;          
    float3 rotation;   // Pitch (X), Yaw (Y), Roll (Z) in degrees
    float2 scale;      
    float3 position;   
    float3 normal;     
    float pad;         
};

// --- Hi-Z Downsampling Resources ---
Texture2D<float> _InputSource;
Texture2D<float> _InputMip;        // Separate Read Handle for Sub-Mips
RWTexture2D<float> _OutputMip;     // Separate Write Handle for Sub-Mips
int2 _OutputSize;

// --- Culling & Indirect Resources ---
StructuredBuffer<ScrapInstanceData> _AllInstancesBuffer;
RWStructuredBuffer<ScrapInstanceData> _CulledInstancesBuffer;
RWStructuredBuffer<uint> _GlobalArgsBuffer;

matrix _VPMatrix;
float4 _FrustumPlanes[6];
float3 _CameraPosition;
float _MaxDrawDistance;
float _BoundingRadius;
int _TotalInstances;
int _MaxInstancesPerType;
int _ScrapTypeCount;
float _ScreenWidth;  
float _ScreenHeight; 
int _MaxMipLevel;
int _HiZEnabled;

Texture2D<float> _HiZBuffer;
SamplerState sampler_PointClamp;

// --- Hi-Z Downsampling Kernels (Reversed-Z Conservative) ---

[numthreads(8, 8, 1)]
void K_DownsampleMip0(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_OutputSize.x || id.y >= (uint)_OutputSize.y) return;

    int2 baseCoords = id.xy * 2;
    float d0 = _InputSource.Load(int3(baseCoords + int2(0, 0), 0));
    float d1 = _InputSource.Load(int3(baseCoords + int2(1, 0), 0));
    float d2 = _InputSource.Load(int3(baseCoords + int2(0, 1), 0));
    float d3 = _InputSource.Load(int3(baseCoords + int2(1, 1), 0));

    // Conservative Reversed-Z: MIN depth guarantees no premature false-culling!
    float conservativeDepth = min(min(d0, d1), min(d2, d3));
    _OutputMip[id.xy] = conservativeDepth;
}

[numthreads(8, 8, 1)]
void K_DownsampleMips(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_OutputSize.x || id.y >= (uint)_OutputSize.y) return;

    int2 baseCoords = id.xy * 2;
    float d0 = _InputMip.Load(int3(baseCoords + int2(0, 0), 0));
    float d1 = _InputMip.Load(int3(baseCoords + int2(1, 0), 0));
    float d2 = _InputMip.Load(int3(baseCoords + int2(0, 1), 0));
    float d3 = _InputMip.Load(int3(baseCoords + int2(1, 1), 0));

    // Conservative Reversed-Z: MIN depth across mips!
    float conservativeDepth = min(min(d0, d1), min(d2, d3));
    _OutputMip[id.xy] = conservativeDepth;
}

// --- Culling Kernels ---

[numthreads(64, 1, 1)]
void ResetIndexBatch(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_ScrapTypeCount) return;
    _GlobalArgsBuffer[id.x * 5 + 1] = 0; 
}

[numthreads(64, 1, 1)]
void CullingBatch(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_TotalInstances) return;

    ScrapInstanceData instance = _AllInstancesBuffer[id.x];
    uint typeIndex = (uint)instance.id;
    if (typeIndex >= (uint)_ScrapTypeCount) return;

    float3 pos = instance.position;
    float maxRadius = _BoundingRadius * max(instance.scale.x, instance.scale.y);

    // 1. Distance Culling
    float distSq = dot(pos - _CameraPosition, pos - _CameraPosition);
    if (distSq > (_MaxDrawDistance * _MaxDrawDistance)) return;

    // 2. Frustum Culling
    [unroll]
    for (int i = 0; i < 6; i++)
    {
        float distanceToPlane = dot(_FrustumPlanes[i].xyz, pos) + _FrustumPlanes[i].w;
        if (distanceToPlane < -maxRadius) return;
    }

    // 3. Conservative Hi-Z Occlusion Culling
    if (_HiZEnabled != 0)
    {
        float3 boxMin = pos - float3(maxRadius, maxRadius, maxRadius);
        float3 boxMax = pos + float3(maxRadius, maxRadius, maxRadius);

        float3 corners[8];
        corners[0] = float3(boxMin.x, boxMin.y, boxMin.z);
        corners[1] = float3(boxMax.x, boxMin.y, boxMin.z);
        corners[2] = float3(boxMin.x, boxMax.y, boxMin.z);
        corners[3] = float3(boxMax.x, boxMax.y, boxMin.z);
        corners[4] = float3(boxMin.x, boxMin.y, boxMax.z);
        corners[5] = float3(boxMax.x, boxMin.y, boxMax.z);
        corners[6] = float3(boxMin.x, boxMax.y, boxMax.z);
        corners[7] = float3(boxMax.x, boxMax.y, boxMax.z);

        float2 uvMin = float2(1.0, 1.0);
        float2 uvMax = float2(0.0, 0.0);
        float instanceNearestDepth = 0.0;
        bool isNearCulledOrInvalid = false;

        [unroll]
        for (int c = 0; c < 8; c++)
        {
            float4 clipPos = mul(_VPMatrix, float4(corners[c], 1.0));

            if (clipPos.w <= 0.001)
            {
                isNearCulledOrInvalid = true;
                break;
            }

            float3 ndc = clipPos.xyz / clipPos.w;
            float2 uv = ndc.xy * 0.5 + 0.5;

            #if UNITY_UV_STARTS_AT_TOP
            uv.y = 1.0 - uv.y;
            #endif

            uvMin = min(uvMin, uv);
            uvMax = max(uvMax, uv);

            // Reversed-Z: largest NDC Z is closest to camera
            instanceNearestDepth = max(instanceNearestDepth, ndc.z);
        }

        if (!isNearCulledOrInvalid)
        {
            uvMin = clamp(uvMin, 0.0, 1.0);
            uvMax = clamp(uvMax, 0.0, 1.0);

            float2 pixelSize = (uvMax - uvMin) * float2(_ScreenWidth, _ScreenHeight);
            float maxPixelSize = max(pixelSize.x, pixelSize.y);

            float mipLevel = clamp(ceil(log2(max(maxPixelSize, 1.0))), 0.0, (float)_MaxMipLevel);

            float d00 = _HiZBuffer.SampleLevel(sampler_PointClamp, uvMin, mipLevel);
            float d10 = _HiZBuffer.SampleLevel(sampler_PointClamp, float2(uvMax.x, uvMin.y), mipLevel);
            float d01 = _HiZBuffer.SampleLevel(sampler_PointClamp, float2(uvMin.x, uvMax.y), mipLevel);
            float d11 = _HiZBuffer.SampleLevel(sampler_PointClamp, uvMax, mipLevel);

            float furthestHiZDepth = min(min(d00, d10), min(d01, d11));

            // Occlusion Test (Reversed-Z: If instance nearest depth < furthest scene depth - bias, it is occluded behind all geometry)
            if (instanceNearestDepth < furthestHiZDepth - 0.0005f)
            {
                return; // Occluded!
            }
        }
    }

    // 4. Append Instance
    uint writeOffset;
    InterlockedAdd(_GlobalArgsBuffer[typeIndex * 5 + 1], 1, writeOffset);

    if (writeOffset < (uint)_MaxInstancesPerType)
    {
        uint targetIndex = (typeIndex * _MaxInstancesPerType) + writeOffset;
        _CulledInstancesBuffer[targetIndex] = instance;
    }
}